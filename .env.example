# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — bypasses RLS. Server-side only, never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used to build links in outgoing e-mails (proposals, resets, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (email delivery) — resend.com/api-keys
RESEND_API_KEY=

# Fallback recipient for admin-facing notifications with no specific recipient
SYSTEM_ADMIN_EMAIL=

# Shared secret the cron endpoints (src/app/api/cron/*) require in an
# Authorization: Bearer header — set this in your scheduler (Vercel Cron, etc.)
# to the same value configured here.
CRON_SECRET=

# Sentry (error monitoring) — optional. Leave blank and the SDK no-ops
# entirely; fill in once a Sentry project exists (sentry.io).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps on build — safe to leave blank.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
